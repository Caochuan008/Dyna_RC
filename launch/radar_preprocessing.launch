<launch>
  <!-- Defaults follow the supplied RaVISLAM launch; no mapping/ESKF/visual nodes. -->
  <arg name="use_sim_time" default="false"/>
  <arg name="radar_topic" default="/radar_v_points"/>
  <arg name="radar_stat_topic" default="/radar_points_inlier"/>
  <arg name="radar_dyna_topic" default="/radar_points_outlier"/>
  <arg name="use_rcs" default="true"/>
  <arg name="radar_type" default="1"/>
  <arg name="n_dof" default="3"/>
  <arg name="ransac_threshold" default="0.95"/>
  <arg name="velocity_accuracy" default="0.02"/>
  <arg name="ground_filter" default="true"/>
  <arg name="unstable_filter" default="true"/>
  <arg name="unstable_radius" default="1.0"/>
  <arg name="unstable_max_dt" default="1.0"/>
  <arg name="min_scan_range" default="0.0"/>
  <arg name="max_scan_range" default="250.0"/>
  <arg name="min_height" default="-10.0"/>
  <arg name="max_height" default="50.0"/>
  <arg name="min_intensity" default="0.0"/>
  <!-- Compatibility only: the supplied implementation never applies voxel filtering. -->
  <arg name="input_leaf_size" default="0.3"/>
  <arg name="t_x" default="0.57"/>
  <arg name="t_y" default="0.0"/>
  <arg name="t_z" default="1.12"/>
  <arg name="mounting_angle_x" default="3.1415926"/>
  <arg name="mounting_angle_y" default="0.0"/>
  <arg name="mounting_angle_z" default="0.0"/>
  <arg name="debug_mode" default="false"/>
  <arg name="tictoc" default="false"/>
  <arg name="timing_log_file" default=""/>

  <param name="use_sim_time" value="$(arg use_sim_time)" type="bool"/>
  <node pkg="dyna_rc" type="radar_ego_motion" name="radar_ego_motion" output="screen" respawn="false">
    <remap from="/radar_points_inlier" to="$(arg radar_stat_topic)"/>
    <remap from="/radar_points_outlier" to="$(arg radar_dyna_topic)"/>
    <!-- Private parameters prevent interference with localization/ICP settings. -->
    <param name="radar_topic" value="$(arg radar_topic)" type="str"/>
    <param name="use_rcs" value="$(arg use_rcs)" type="bool"/>
    <param name="radar_type" value="$(arg radar_type)" type="int"/>
    <param name="n_dof" value="$(arg n_dof)" type="int"/>
    <param name="ransac_threshold" value="$(arg ransac_threshold)" type="double"/>
    <param name="velocity_accuracy" value="$(arg velocity_accuracy)" type="double"/>
    <param name="ground_filter" value="$(arg ground_filter)" type="bool"/>
    <param name="unstable_filter" value="$(arg unstable_filter)" type="bool"/>
    <param name="unstable_radius" value="$(arg unstable_radius)" type="double"/>
    <param name="unstable_max_dt" value="$(arg unstable_max_dt)" type="double"/>
    <param name="min_scan_range" value="$(arg min_scan_range)" type="double"/>
    <param name="max_scan_range" value="$(arg max_scan_range)" type="double"/>
    <param name="min_height" value="$(arg min_height)" type="double"/>
    <param name="max_height" value="$(arg max_height)" type="double"/>
    <param name="min_intensity" value="$(arg min_intensity)" type="double"/>
    <param name="input_leaf_size" value="$(arg input_leaf_size)" type="double"/>
    <param name="t_x" value="$(arg t_x)" type="double"/>
    <param name="t_y" value="$(arg t_y)" type="double"/>
    <param name="t_z" value="$(arg t_z)" type="double"/>
    <param name="mounting_angle_x" value="$(arg mounting_angle_x)" type="double"/>
    <param name="mounting_angle_y" value="$(arg mounting_angle_y)" type="double"/>
    <param name="mounting_angle_z" value="$(arg mounting_angle_z)" type="double"/>
    <param name="debug_mode" value="$(arg debug_mode)" type="bool"/>
    <param name="tictoc" value="$(arg tictoc)" type="bool"/>
    <param name="timing_log_file" value="$(arg timing_log_file)" type="str"/>
  </node>
</launch>
